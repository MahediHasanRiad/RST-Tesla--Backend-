{
  "name": "dhaka-tesla-pool-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --import tsx/esm src/server.ts",
    "dev:worker:notification": "node --import tsx/esm src/workers/notification.worker.ts",
    "dev:worker:email": "node --import tsx/esm src/workers/email.worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker:notification": "node dist/workers/notification.worker.js",
    "worker:email": "node dist/workers/email.worker.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/sticky": "^1.0.4",
    "@supabase/supabase-js": "^2.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.10",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "openai": "^6.0.0",
    "pg": "^8.16.0",
    "socket.io": "^4.8.4",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
