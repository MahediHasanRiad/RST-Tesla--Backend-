generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum VehicleAvailability {
  OFFLINE
  ONLINE
}

enum PoolStatus {
  CLOSE
  OPEN
}

enum RideRequestStatus {
  REQUESTED
  PENDING_DRIVER_ACCEPTANCE
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TESLA_PAY
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  role                UserRole
  name                String
  email               String    @unique
  phone               String    @unique
  password            String
  isEmailVerified     Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  avatar              String?
  avatarPublicId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rideRequests    RideRequest[]       @relation("PassengerRequests")
  statusChanges   RideStatusHistory[] @relation("StatusChangedBy")
  driver          Driver?
}

model AuthRateLimit {
  id          String   @id @default(uuid()) @db.Uuid
  scope       String
  keyHash     String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, keyHash])
}

model Driver {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @unique @db.Uuid
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  experienceYears Int?
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  vehicle         Vehicle?
}

model Vehicle {
  id           String              @id @default(uuid()) @db.Uuid
  driverId     String              @unique @db.Uuid
  name         String
  capacity     Int
  availability VehicleAvailability @default(ONLINE)
  images       String[]            @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver Driver     @relation(fields: [driverId], references: [id])
  pools  RidePool[]
}

model ServiceZone {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupPools         RidePool[]    @relation("PoolPickupZone")
  destinationPools    RidePool[]    @relation("PoolDestinationZone")
  pickupRequests      RideRequest[] @relation("RequestPickupZone")
  destinationRequests RideRequest[] @relation("RequestDestinationZone")
}

model RidePool {
  id                String        @id @default(uuid()) @db.Uuid
  vehicleId         String        @db.Uuid
  pickupZoneId      String        @db.Uuid
  destinationZoneId String        @db.Uuid
  status            PoolStatus    @default(CLOSE)
  reservedSeats     Int           @default(0)
  vehicle           Vehicle       @relation(fields: [vehicleId], references: [id])
  pickupZone        ServiceZone   @relation("PoolPickupZone", fields: [pickupZoneId], references: [id])
  destinationZone   ServiceZone   @relation("PoolDestinationZone", fields: [destinationZoneId], references: [id])
  requests          RideRequest[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([vehicleId, status])
  @@index([pickupZoneId, status])
}

model RideRequest {
  id                String            @id @default(uuid()) @db.Uuid
  passengerId       String?           @db.Uuid
  poolId            String?           @db.Uuid
  pickupZoneId      String            @db.Uuid
  destinationZoneId String            @db.Uuid
  requestedSeats    Int
  enableRidePool    Boolean           @default(false)
  status            RideRequestStatus @default(PENDING_DRIVER_ACCEPTANCE)
  farePaisa         Int?

  passenger       User?               @relation("PassengerRequests", fields: [passengerId], references: [id], onDelete: SetNull)
  pool            RidePool?           @relation(fields: [poolId], references: [id])
  pickupZone      ServiceZone         @relation("RequestPickupZone", fields: [pickupZoneId], references: [id])
  destinationZone ServiceZone         @relation("RequestDestinationZone", fields: [destinationZoneId], references: [id])
  statusHistory   RideStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pickupZoneId, status])
  @@index([destinationZoneId])
  @@index([passengerId, createdAt])
}

model RideStatusHistory {
  id          String             @id @default(uuid()) @db.Uuid
  requestId   String             @db.Uuid
  fromStatus  RideRequestStatus?
  toStatus    RideRequestStatus
  changedById String?            @db.Uuid
  request     RideRequest        @relation(fields: [requestId], references: [id])
  changedBy   User?              @relation("StatusChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime           @default(now())

  @@index([requestId, createdAt])
}
